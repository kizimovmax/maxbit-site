{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": { "contentSize": "760px", "wideSize": "1200px" },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "ink", "color": "#0F172A", "name": "Текст" },
        { "slug": "ink-2", "color": "#475569", "name": "Текст вторичный" },
        { "slug": "accent", "color": "#2563EB", "name": "Акцент" },
        { "slug": "accent-soft", "color": "#EFF4FF", "name": "Акцент светлый" },
        { "slug": "surface", "color": "#F5F7FA", "name": "Фон" },
        { "slug": "white", "color": "#FFFFFF", "name": "Белый" },
        { "slug": "line", "color": "#E2E8F0", "name": "Линия" },
        { "slug": "warning", "color": "#B45309", "name": "Предупреждение" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        { "slug": "system", "name": "Golos Text (в комплекте темы)", "fontFamily": "'Golos Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.9rem", "name": "Мелкий" },
        { "slug": "medium", "size": "1.0625rem", "name": "Обычный" },
        { "slug": "large", "size": "1.375rem", "name": "Крупный" },
        { "slug": "x-large", "size": "2rem", "name": "Заголовок" }
      ],
      "lineHeight": false,
      "dropCap": false
    },
    "spacing": { "units": [ "px", "rem" ], "padding": false, "margin": false, "blockGap": true },
    "blocks": {
      "core/group": { "color": { "background": true } }
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--system)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--accent)" } },
      "h1": { "typography": { "fontSize": "clamp(2rem, 4vw, 2.75rem)", "lineHeight": "1.15", "fontWeight": "700" } },
      "h2": { "typography": { "fontSize": "clamp(1.5rem, 2.6vw, 1.9rem)", "lineHeight": "1.25", "fontWeight": "700" } },
      "h3": { "typography": { "fontSize": "1.2rem", "lineHeight": "1.3", "fontWeight": "600" } }
    }
  }
}
